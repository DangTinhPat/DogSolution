initialState
{
   ;; Normalized Centroidal Momentum: [linear, angular] ;;
   (0,0)  0.0     ; vcom_x
   (1,0)  0.0     ; vcom_y
   (2,0)  0.0     ; vcom_z
   (3,0)  0.0     ; L_x / robotMass
   (4,0)  0.0     ; L_y / robotMass
   (5,0)  0.0     ; L_z / robotMass

   ;; Base Pose: [position, orientation] ;;
   (6,0)  0.0     ; p_base_x
   (7,0)  0.0     ; p_base_y
   (8,0)  0.22    ; p_base_z
   (9,0)  0.0     ; theta_base_z
   (10,0) 0.0     ; theta_base_y
   (11,0) 0.0     ; theta_base_x

   ;; Leg Joint Positions: [LF, LH, RF, RH] - must match reference.info's
   ;; defaultJointState; this block was stale at A1's old numbers (KFE=-1.44
   ;; even fell outside devq's real calf position limit [0.436,2.705]) ;;
   ;; HAA bumped 0.30->0.40 rad: urdf-expert FK analysis found devq's fixed
   ;; hip lateral offset is a much larger fraction of its 25%-shorter legs
   ;; than A1's, so devq's stance looks ~3x more "splayed" than A1's at
   ;; matching HAA angles (0.30 rad was already narrower than A1's own 0.20
   ;; would give on devq's geometry - lowering it further would WIDEN the
   ;; stance, not narrow it). Increasing HAA magnitude is the only lever
   ;; that narrows devq's stance; 0.40 keeps ~2.5cm clearance to the trunk's
   ;; lateral envelope. 0.40 is CLOSED/FINAL - five independent mechanisms
   ;; across both WBC and NMPC layers were tried to push this to 0.45 and
   ;; all failed the same way (real joint overshoot past the 0.50 rad
   ;; self-collision danger zone); see MegadogController.cpp's
   ;; kStandingJointTargetRad comment for the full story and root cause.
   ;; HFE/KFE bumped 0.574027/-1.37275 -> 0.478618/-1.181561: urdf-expert's
   ;; FK analysis found the old values were never kinematically consistent
   ;; with p_base_z=0.22 above (naturally producing ~0.239m instead), which
   ;; is why STAND (all 4 legs pinned here) visibly settled higher than
   ;; TROT_IN_PLACE (only 2 legs pinned at a time). New values solved via
   ;; FK to land exactly at 0.22m - see MegadogController.cpp's
   ;; kStandingJointTargetRad comment for the full story, including the
   ;; KFE-singularity-clearance re-verification this needed.
   (12,0) -0.40       ; LF_HAA
   (13,0)  0.478618   ; LF_HFE
   (14,0) -1.181561   ; LF_KFE
   (15,0) -0.40       ; LH_HAA
   (16,0)  0.478618   ; LH_HFE
   (17,0) -1.181561   ; LH_KFE
   (18,0)  0.40       ; RF_HAA
   (19,0)  0.478618   ; RF_HFE
   (20,0) -1.181561   ; RF_KFE
   (21,0)  0.40       ; RH_HAA
   (22,0)  0.478618   ; RH_HFE
   (23,0) -1.181561   ; RH_KFE
}

; standard state weight matrix
Q
{
  scaling 1e+0

  ;; Normalized Centroidal Momentum: [linear, angular] ;;
  (0,0)   15.0     ; vcom_x
  (1,1)   15.0     ; vcom_y
  (2,2)   100.0    ; vcom_z
  (3,3)   10.0     ; L_x / robotMass
  (4,4)   30.0     ; L_y / robotMass
  (5,5)   30.0     ; L_z / robotMass

  ;; Base Pose: [position, orientation] ;;
  ; A1-baseline pose weights. Earlier devq length-scaled values made trot
  ; in-place too aggressive and amplified pitch/roll oscillation.
  (6,6)   1000.0   ; p_base_x
  (7,7)   1000.0   ; p_base_y
  (8,8)   1500.0   ; p_base_z
  ; theta_base_z (yaw) was 100.0 - a clear outlier vs. roll/pitch's 300.0
  ; (3-15x weaker than every other base-pose axis). Root-caused this session
  ; (balance-expert) as why lateral strafing (base_velocity_y_m_s only,
  ; heading meant to stay fixed) showed a persistent ~0.035-0.065 rad yaw
  ; drift that never decayed back to the commanded heading over 80+s: with
  ; yaw this cheap to violate, the NMPC's own optimal trajectory had little
  ; incentive to fully cancel the emergent yaw moment that diagonal-pair
  ; lateral trotting naturally produces (asymmetric CoM-Y-acceleration GRF
  ; lever arms) - no downstream WBC gain can fix a bias already baked into
  ; the MPC's own reference. Raised to parity with theta_base_y/x (300.0) -
  ; a single-axis change, distinct from an earlier reverted experiment that
  ; touched position AND roll/pitch weights together and amplified
  ; oscillation (that regression was attributed to the position/roll/pitch
  ; coupling, not yaw - see comment above). If this alone doesn't fully
  ; close the gap, base_angular_kp/kd (makeDevqWbcConfig()) is the next,
  ; separately-tested lever - see MegadogController.cpp's comment there.
  (9,9)   300.0    ; theta_base_z
  (10,10) 300.0    ; theta_base_y
  (11,11) 300.0    ; theta_base_x

  ;; Leg Joint Positions: [LF, LH, RF, RH] ;;
  ; A1-baseline joint posture weights. HAA width is handled by the WBC posture
  ; task, not by over-tight NMPC state cost.
  (12,12) 5.0     ; LF_HAA
  (13,13) 5.0     ; LF_HFE
  (14,14) 2.5     ; LF_KFE
  (15,15) 5.0     ; LH_HAA
  (16,16) 5.0     ; LH_HFE
  (17,17) 2.5     ; LH_KFE
  (18,18) 5.0     ; RF_HAA
  (19,19) 5.0     ; RF_HFE
  (20,20) 2.5     ; RF_KFE
  (21,21) 5.0     ; RH_HAA
  (22,22) 5.0     ; RH_HFE
  (23,23) 2.5     ; RH_KFE
}

