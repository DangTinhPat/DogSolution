  verboseCppAd                  false
  recompileLibrariesCppAd       false
  modelFolderCppAd              /tmp/ocs2_megadog_babydog_home_lf_lh_rf_rh

  ; Pinocchio/centroidal joint order must match megadog_controller's
  ; ros2_control command/state interface order. OCS2's compiled-in default is
  ; LF,RF,LH,RH; leaving that default active swapped RF and LH torques/states
  ; at the controller boundary.
  jointNames
  {
    [0]  LF_HAA
    [1]  LF_HFE
    [2]  LF_KFE
    [3]  LH_HAA
    [4]  LH_HFE
    [5]  LH_KFE
    [6]  RF_HAA
    [7]  RF_HFE
    [8]  RF_KFE
    [9]  RH_HAA
    [10] RH_HFE
    [11] RH_KFE
  }

  ; Contact order intentionally remains OCS2's gait order: {LF, RF, LH, RH}.
  contactNames3DoF
  {
    [0] LF_FOOT
    [1] RF_FOOT
    [2] LH_FOOT
    [3] RH_FOOT
  }
}

swing_trajectory_config
{
  liftOffVelocity               0.06
  ; Was -0.12 (~20% faster than ultraDog's -0.10) until a user-reported
  ; "dip" during trot phase transitions was root-caused: contact is
  ; scheduled, not sensed (no real contact sensor - see
  ; BaseStateEstimator.h), and formulateNoContactMotionTask() hard-commits
  ; to "this leg is down" exactly at the gait schedule's switching time
  ; regardless of whether the foot has physically landed yet. A faster
  ; touchdown velocity widens that timing-mismatch window, letting the WBC
  ; occasionally allocate support force to a leg not yet on the ground,
  ; transiently under-loading the real stance leg(s). -0.10 matches
  ; ultraDog exactly and shrinks both the momentum a real touchdown must
  ; absorb and the position-mismatch-per-unit-tracking-lag at the switch
  ; instant. Paired with a WbcBase.cpp fix (jointAccel_/modeLast_) for a
  ; second, independent contributor to the same symptom - see that file's
  ; doc comment.
  touchDownVelocity            -0.10
  swingHeight                   0.05  ; 5 cm clearance for a lower, A1-like swing arc on megaDog
  swingTimeScale                0.15
}

; DDP settings
ddp
{
  algorithm                       SLQ

  nThreads                        3
  threadPriority                  50

  maxNumIterations                1
  minRelCost                      1e-1
  constraintTolerance             5e-3

  displayInfo                     false
  displayShortSummary             false
  checkNumericalStability         false
  debugPrintRollout               false
  debugCaching                    false

  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  maxNumStepsPerSecond            10000
  timeStep                        0.015
  backwardPassIntegratorType      ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0

  preComputeRiccatiTerms          true

  useFeedbackPolicy               false

  strategy                        LINE_SEARCH
  lineSearch
  {
    minStepLength                 1e-2
    maxStepLength                 1.0
    hessianCorrectionStrategy     DIAGONAL_SHIFT
    hessianCorrectionMultiple     1e-5
  }
}


