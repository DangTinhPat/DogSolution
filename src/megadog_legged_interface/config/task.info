  ; legged_control's own task.info predates these two keys in the pinned
  ; ocs2_legged_robot commit vendored here (see babyDog's task.info, which
  ; needed the same addition) - false matches babyDog's own working values.
  useAnalyticalGradientsDynamics        false
  useAnalyticalGradientsConstraints     false
}

model_settings
{
