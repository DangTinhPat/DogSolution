<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>megadog_description</name>
  <version>0.0.1</version>
  <description>
    Unitree A1 description ported to ros2_control/Gazebo Harmonic from
    qiayuanl/legged_control's legged_unitree_description (ROS1). Milestone 1
    of the megaDog port: bare sim bring-up only, no NMPC/WBC yet.
  </description>
  <maintainer email="dvt@example.com">dvt</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>megadog_controller</exec_depend>
  <exec_depend>imu_kalman_filter</exec_depend>
  <exec_depend>main_bot_hardware</exec_depend>
  <exec_depend>main_bot_hardware_msgs</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
