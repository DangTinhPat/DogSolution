<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>main_bot_hardware</name>
    <version>0.0.0</version>
    <description>ros2_control hardware interface for real babyDog: relays independent position/velocity/Kp/Kd/Tff commands for 12 joints to STM32H7 over micro-ROS/UART.</description>
    <maintainer email="dangtinh.ftcpy@gmail.com">dvt</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>hardware_interface</depend>
    <depend>pluginlib</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_lifecycle</depend>
    <depend>main_bot_hardware_msgs</depend>

    <exec_depend>controller_manager</exec_depend>
    <exec_depend>micro_ros_agent</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
        <hardware_interface plugin="${prefix}/main_bot_hardware.xml"/>
    </export>
</package>
