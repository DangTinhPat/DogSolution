## ocs2_legged_robot: ModelSettings can load jointNames/contactNames3DoF/contactNames6DoF from the task file
# Reason: LeggedRobotInterface's constructor only takes (taskFile, urdfFile,
# referenceFile) and builds the whole OptimalControlProblem internally from
# ModelSettings loaded via loadModelSettings(taskFile, "model_settings").
# That loader only read scalar fields; jointNames/contactNames3DoF stayed
# hardcoded to ANYmal's names (LF_HAA... / LF_FOOT...) with no way to
# override them short of forking the struct. babyDog needs its own joint
# and foot-frame names. Purely additive: loadStdVector leaves the struct's
# ANYmal defaults untouched if the fields are absent from task.info, so
# existing ANYmal/qm_control-style task files are unaffected.

--- /tmp/ModelSettings.h.orig	2026-08-24 22:52:16.337909130 +0700
+++ src/ocs2/ocs2_robotic_examples/ocs2_legged_robot/include/ocs2_legged_robot/common/ModelSettings.h	2026-08-24 22:52:24.234013128 +0700
@@ -48,6 +48,10 @@
   std::string modelFolderCppAd = "/tmp/ocs2";
 
   // This is only used to get names for the knees and to check urdf for extra joints that need to be fixed.
+  // Overridable from the task file's model_settings block (jointNames /
+  // contactNames3DoF / contactNames6DoF) so non-ANYmal robots (e.g. babyDog)
+  // don't need to fork this struct's defaults. See babyDog's
+  // src/ocs2/JAZZY_LOCAL_PATCHES.diff for why this was added.
   std::vector<std::string> jointNames{"LF_HAA", "LF_HFE", "LF_KFE", "RF_HAA", "RF_HFE", "RF_KFE",
                                       "LH_HAA", "LH_HFE", "LH_KFE", "RH_HAA", "RH_HFE", "RH_KFE"};
   std::vector<std::string> contactNames6DoF{};
--- /tmp/ModelSettings.cpp.orig	2026-08-24 22:52:16.339909157 +0700
+++ src/ocs2/ocs2_robotic_examples/ocs2_legged_robot/src/common/ModelSettings.cpp	2026-08-24 22:52:33.434134561 +0700
@@ -55,6 +55,13 @@
   loadData::loadPtreeValue(pt, modelSettings.recompileLibrariesCppAd, fieldName + ".recompileLibrariesCppAd", verbose);
   loadData::loadPtreeValue(pt, modelSettings.modelFolderCppAd, fieldName + ".modelFolderCppAd", verbose);
 
+  // Optional: override the compiled-in ANYmal joint/contact names for robots
+  // with a different naming convention. Falls back to the struct defaults
+  // above if the field is absent (loadStdVector leaves loadVector untouched).
+  loadData::loadStdVector(filename, fieldName + ".jointNames", modelSettings.jointNames, verbose);
+  loadData::loadStdVector(filename, fieldName + ".contactNames3DoF", modelSettings.contactNames3DoF, verbose);
+  loadData::loadStdVector(filename, fieldName + ".contactNames6DoF", modelSettings.contactNames6DoF, verbose);
+
   if (verbose) {
     std::cerr << " #### =============================================================================" << std::endl;
   }
